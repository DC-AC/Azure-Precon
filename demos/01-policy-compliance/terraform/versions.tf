terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "azurerm" {
  features {}

  # Leave unset to inherit ARM_SUBSCRIPTION_ID / `az account show`.
  subscription_id = var.subscription_id != "" ? var.subscription_id : null
}
