# Terraform
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Committing it pins the
# provider version so the stack you rehearsed is the stack you present.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.pdf

# Never commit real values — terraform.tfvars.example is the template
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Azure Functions local dev
local.settings.json
__pycache__/
.venv/
.python_packages/
bin/
obj/
