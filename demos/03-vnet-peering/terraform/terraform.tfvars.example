# Copy to terraform.tfvars and edit as needed.

# subscription_id = "00000000-0000-0000-0000-000000000000"
prefix   = "azpre"
location = "eastus2"

hub_address_space    = "10.0.0.0/16"
spoke1_address_space = "10.1.0.0/16"
spoke2_address_space = "10.2.0.0/16"

# One small VM per spoke plus one in the hub. Needed to prove connectivity.
deploy_test_vms = true
vm_size         = "Standard_B2ats_v2"

# Leave FALSE for the live demo — the failed spoke-to-spoke ping is the point.
enable_spoke_to_spoke_peering = false

# 30-45 minute provision, ~$0.19/hour. Deploy the day before if you want it.
deploy_vpn_gateway = false

# ~$0.19/hour. Only needed if you also want to cover the Azure Bastion slide.
deploy_bastion = false
